<% var pageTitle = 'નોંધણી સફળ'; %>
<% var bodyClass = 'page-register'; %>
<%- include('partials/header') %>

<div class="container">
  <div class="card text-center fade-in-up">
    <div class="alert alert-success stagger" style="--d:1">✅ તમારી વિગતો સફળતાપૂર્વક સાચવવામાં આવી છે!</div>

    <h1 class="mt-0 stagger" style="--d:2">નમસ્તે <%= record.name %>, આ રહ્યો તમારો QR કોડ.</h1>
    <p class="subtitle stagger" style="--d:3">🔒 તમારી વિગતો ખાનગી છે. ચેક-ઇન કરતી વખતે આ QR કોડ સ્કેન કરીને ફક્ત યુવા સંગમ એડમિન જ તેમને જોઈ શકે છે.</p>
    <p class="subtitle stagger" style="--d:4">📧 અમે તમને આ QR કોડ પણ ઇમેઇલ કરી રહ્યા છીએ — તે ટૂંક સમયમાં આવી જશે.</p>

    <div class="qr-box stagger" style="--d:5">
      <img src="<%= qrUrl %>" alt="QR code for <%= record.name %>" />
    </div>


    <div class="actions-row stagger" style="--d:6; justify-content:center;">
      <a href="<%= qrUrl %>" download="qr-<%= record.name.replace(/\s+/g,'-') %>.png" class="btn btn-glow">⬇ QR ડાઉનલોડ કરો</a>
      <a href="/register" class="btn btn-secondary">અન્ય નોંધણી કરો</a>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
