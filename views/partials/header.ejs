<!DOCTYPE html>
<html lang="gu">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'QR Registration App' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Anek+Gujarati:wght@300;400;600;700;800&family=Poppins:wght@400;500;600;700;800&family=Noto+Sans+Gujarati:wght@400;500;600;700;800&family=Yatra+One&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body class="<%= typeof bodyClass !== 'undefined' ? bodyClass : '' %>">
<!-- Slim organisation banner -->
<div class="top-org-bar">રાષ્ટ્રીય સ્વયંસેવક સંઘ</div>

<!-- Ambient particle background -->
<canvas id="particle-canvas"></canvas>

<!-- Ambient background music + toggle -->
<audio id="ambient-audio" autoplay preload="auto" loop>
  <source src="/audio/bg-music.mp3" type="audio/mpeg">
</audio>
<div class="audio-control" id="audio-toggle" title="સંગીત ચાલુ/બંધ કરો">
  <svg class="volume-on" viewBox="0 0 24 24" fill="currentColor"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/></svg>
  <svg class="volume-off hidden" viewBox="0 0 24 24" fill="currentColor"><path d="M16.5 12A4.5 4.5 0 0014 7.97v1.79l2.48 2.48c.01-.08.02-.16.02-.24zM19 12c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z"/></svg>
</div>

<% if (typeof bodyClass !== 'undefined' && (bodyClass === 'page-register' || bodyClass === 'page-admin-login')) { %>
  <div class="page-bg-image" aria-hidden="true"></div>
  <div class="page-bg-overlay" aria-hidden="true"></div>
<% } %>
<div class="bg-orb bg-orb-1"></div>
<div class="bg-orb bg-orb-2"></div>
<div class="bg-orb bg-orb-3"></div>

<div class="topbar">
  <a href="/register" class="brand"><span class="brand-dot"></span>યુવા સંગમ ૨૦૨૬ (રાષ્ટ્રીય સ્વયંસેવક સંઘ - નરોડા ભાગ)</a>
  <nav>
    <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
      <a href="/admin/dashboard">ડેશબોર્ડ</a>
      <% if (typeof adminRole !== 'undefined' && adminRole === 'main') { %>
        <a href="/admin/events">ઇવેન્ટ્સ</a>
        <a href="/admin/event-admins">ઇવેન્ટ એડમિન</a>
      <% } else { %>
        <a href="/admin/events">મારો ઇવેન્ટ</a>
      <% } %>
      <form action="/admin/logout" method="POST" style="display:inline">
        <button type="submit">લોગઆઉટ</button>
      </form>
    <% } else { %>
      <a href="/register">નોંધણી કરો</a>
      <a href="/admin/login">એડમિન લોગિન</a>
    <% } %>
  </nav>
</div>
