<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'QR Registration App' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&family=Noto+Sans+Gujarati:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
<div class="bg-orb bg-orb-1"></div>
<div class="bg-orb bg-orb-2"></div>
<div class="bg-orb bg-orb-3"></div>

<div class="topbar">
  <a href="/register" class="brand"><span class="brand-dot"></span>YUVA SANGAM 2026 | યુવા સંગમ ૨૦૨૬</a>
  <nav>
    <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
      <a href="/admin/dashboard">Dashboard</a>
      <form action="/admin/logout" method="POST" style="display:inline">
        <button type="submit">Logout</button>
      </form>
    <% } else { %>
      <a href="/register">Register</a>
      <a href="/admin/login">Admin Login</a>
    <% } %>
  </nav>
</div>
