<% var pageTitle = 'કસ્ટમ ઈમેલ મોકલો - એડમિન'; %>
<%- include('partials/header') %>

<div class="container fade-in-up">
  <div class="card admin-form-card">
    <h1 style="margin-bottom:4px;">✉️ કસ્ટમ ઈમેલ મોકલો</h1>
    <p class="subtitle">કોઈપણ એક ઈમેલ સરનામે તરત જ સંદેશ મોકલો — વપરાશકર્તા યાદીમાંથી અથવા કોઈપણ કસ્ટમ સરનામે.</p>

    <% if (result) { %>
      <div class="msg-banner <%= result.sent ? 'success' : 'error' %>">
        <% if (result.sent) { %>
          ✓ ઈમેલ <strong><%= result.to %></strong> પર સફળતાપૂર્વક મોકલાયો.
        <% } else if (result.skipped) { %>
          ⚠ ઈમેલ મોકલાયો નહીં — ઈમેલ સેવા (Brevo) કન્ફિગર થયેલી નથી.
        <% } else { %>
          ✕ ઈમેલ <strong><%= result.to %></strong> પર મોકલવામાં નિષ્ફળ.
        <% } %>
      </div>
    <% } %>

    <% if (error) { %>
      <div class="alert alert-error shake"><%= error %></div>
    <% } %>

    <form method="POST" action="/admin/custom-email">
      <div class="field">
        <label for="to">પ્રાપ્તકર્તાનું ઈમેલ <span class="req">*</span></label>
        <input type="email" id="to" name="to" required value="<%= formData.to || '' %>" placeholder="દા.ત. name@example.com" />
        <p class="help-text">કોઈપણ ઈમેલ સરનામું લખો — તે વપરાશકર્તા યાદીમાં હોવું જરૂરી નથી.</p>
      </div>

      <div class="field">
        <label for="name">પ્રાપ્તકર્તાનું નામ (વૈકલ્પિક)</label>
        <input type="text" id="name" name="name" value="<%= formData.name || '' %>" placeholder="દા.ત. રમેશ પટેલ" />
      </div>

      <div class="field">
        <label for="subject">વિષય <span class="req">*</span></label>
        <input type="text" id="subject" name="subject" required value="<%= formData.subject || '' %>" placeholder="દા.ત. યુવા સંગમ ૨૦૨૬ - અગત્યની જાણકારી" />
      </div>

      <div class="field">
        <label for="message">સંદેશ <span class="req">*</span></label>
        <textarea id="message" name="message" required rows="8" placeholder="તમારો સંદેશ અહીં લખો..."><%= formData.message || '' %></textarea>
        <p class="help-text">દરેક ફકરો ખાલી લાઇનથી અલગ કરો — તે ઇમેલમાં અલગ ફકરા તરીકે દેખાશે.</p>
      </div>

      <div class="actions-row">
        <button type="submit" class="btn btn-glow">📤 ઈમેલ મોકલો</button>
        <a href="/admin/dashboard" class="btn btn-secondary">રદ કરો</a>
      </div>
    </form>
  </div>
</div>

<%- include('partials/footer') %>
