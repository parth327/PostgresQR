<% var pageTitle = 'નવો ઇવેન્ટ બનાવો - એડમિન'; %>
<%- include('partials/header') %>

<div class="container fade-in-up">
  <div class="card admin-form-card">
    <h1>નવો ઇવેન્ટ બનાવો</h1>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-error shake"><%= error %></div>
    <% } %>

    <form method="POST" action="/admin/events/create">
      <div class="field">
        <label for="eventName">ઇવેન્ટનું નામ <span class="req">*</span></label>
        <input
          type="text"
          id="eventName"
          name="eventName"
          value="<%= event && event.eventName ? event.eventName : '' %>"
          placeholder="દા.ત. વાર્ષિક સંમેલન ૨૦૨૬"
          required
        >
        <p class="help-text">ઇવેન્ટને યાદગાર નામ આપો</p>
      </div>

      <div class="field">
        <label for="eventDate">ઇવેન્ટની તારીખ <span class="req">*</span></label>
        <input
          type="date"
          id="eventDate"
          name="eventDate"
          value="<%= (event && event.eventDate) || today %>"
          required
        >
        <p class="help-text">ઇવેન્ટ ક્યારે યોજાશે તે તારીખ પસંદ કરો</p>
      </div>

      <div class="field">
        <label for="location">સ્થળ</label>
        <input
          type="text"
          id="location"
          name="location"
          value="<%= event && event.location ? event.location : '' %>"
          placeholder="દા.ત. કન્વેન્શન સેન્ટર, નરોડા"
        >
        <p class="help-text">ઇવેન્ટ ક્યાં યોજાશે?</p>
      </div>

      <div class="field">
        <label for="maxCapacity">મહત્તમ ક્ષમતા</label>
        <input
          type="number"
          id="maxCapacity"
          name="maxCapacity"
          value="<%= event && event.maxCapacity ? event.maxCapacity : '' %>"
          placeholder="દા.ત. 500"
          min="1"
        >
        <p class="help-text">મહત્તમ સહભાગીઓની સંખ્યા (વૈકલ્પિક)</p>
      </div>

      <div class="field">
        <label for="eventDescription">વર્ણન</label>
        <textarea
          id="eventDescription"
          name="eventDescription"
          placeholder="ઇવેન્ટ વિશે વધારાની વિગતો ઉમેરો..."
        ><%= event && event.eventDescription ? event.eventDescription : '' %></textarea>
        <p class="help-text">વૈકલ્પિક: વિગતો, કાર્યક્રમ અથવા નોંધ ઉમેરો</p>
      </div>

      <div class="actions-row">
        <button type="submit" class="btn btn-glow">✓ ઇવેન્ટ બનાવો</button>
        <a href="/admin/events" class="btn btn-secondary">રદ કરો</a>
      </div>
    </form>
  </div>
</div>

<%- include('partials/footer') %>
