<% var pageTitle = 'ઇવેન્ટ ચેક-ઇન'; %>
<%- include('partials/header') %>
<script src="https://cdn.jsdelivr.net/npm/@zxing/library@0.20.0/umd/index.min.js"></script>

<div class="wide-container fade-in-up">
  <% if (!event) { %>
    <div class="empty-state card">
      <h2 style="margin-top:0;">📋 કોઈ ઇવેન્ટ મળ્યો નહીં</h2>
      <p><%= error %></p>
      <a href="/admin/events" class="btn">ઇવેન્ટ્સ પર જાઓ</a>
    </div>
  <% } else { %>
    <div class="event-hero">
      <h1>✓ ચેક-ઇન: <%= event.event_name %></h1>
      <p>📅 <%= formatEventDateGu(event.event_date) %></p>
      <% if (event.location) { %>
        <p>📍 <%= event.location %></p>
      <% } %>
      <div class="header-stats">
        <div class="stat-item">
          <div class="stat-value"><%= stats.total_checked_in %></div>
          <div class="stat-label">ચેક-ઇન થયેલા</div>
        </div>
        <% if (event.max_capacity) { %>
          <div class="stat-item">
            <div class="stat-value"><%= event.max_capacity %></div>
            <div class="stat-label">ક્ષમતા</div>
          </div>
        <% } %>
      </div>
    </div>

    <div id="messageContainer"></div>

    <div class="scanner-card">
      <h2>🎯 QR કોડ સ્કેન કરો અથવા વપરાશકર્તા ID દાખલ કરો</h2>

      <h3>કૅમેરા સ્કેનર</h3>
      <div class="camera-controls">
        <button id="startBtn" class="btn" onclick="startScanner()">📷 કૅમેરા શરૂ કરો</button>
        <button id="stopBtn" class="btn btn-danger" style="display:none;" onclick="stopScanner()">🛑 કૅમેરા બંધ કરો</button>
      </div>
      <video id="video" style="display: none;"></video>
      <div id="result"></div>

      <h3>જાતે દાખલ કરો</h3>
      <div class="manual-checkin">
        <input
          type="text"
          id="manualInput"
          placeholder="વપરાશકર્તા ID પેસ્ટ/સ્કેન કરો અથવા ટાઈપ કરો"
          onkeypress="handleManualInput(event)"
          autocomplete="off"
        >
        <button class="btn" onclick="performCheckIn()">➕ ચેક-ઇન કરો</button>
      </div>
    </div>

    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px; margin:24px 0 8px;">
      <h2 style="margin:0;">👥 હાજર લોકો (<%= attendance.length %>/<%= event.max_capacity || '∞' %>)</h2>
      <% if (attendance.length > 0) { %>
        <a href="/admin/events/<%= event.id %>/export" class="btn btn-secondary btn-sm">⬇ એક્સેલમાં એક્સપોર્ટ કરો</a>
      <% } %>
    </div>

    <% if (attendance.length === 0) { %>
      <div class="empty-state card">
        <p>હજુ સુધી કોઈએ ચેક-ઇન કર્યું નથી. QR કોડ સ્કેન કરવાનું શરૂ કરો!</p>
      </div>
    <% } else { %>
      <div class="attendance-list">
        <% attendance.forEach(function(person) { %>
          <div class="attendee-card">
            <h4><%= person.name %></h4>
            <p>📞 <strong><%= person.phone %></strong></p>
            <% if (person.email) { %>
              <p>📧 <%= person.email %></p>
            <% } %>
            <% if (person.location) { %>
              <p>📍 <%= person.location === 'અન્ય' ? (person.location_other || person.location) : person.location %></p>
            <% } %>
            <p class="checkin-time">✓ <%= formatTimeGu(person.checked_in_at) %></p>
            <p class="checkin-by">દ્વારા: <%= person.checked_in_by %></p>
            <button
              class="btn btn-danger btn-sm"
              style="width:100%; margin-top:8px;"
              onclick="removeCheckIn('<%= person.record_id %>')"
            >
              ✕ દૂર કરો
            </button>
          </div>
        <% }); %>
      </div>
    <% } %>

    <div class="actions-row" style="margin-top:24px; padding-top:20px; border-top:1px solid var(--border);">
      <a href="/admin/events/<%= event.id %>" class="btn">📊 ઇવેન્ટ વિગતો</a>
      <a href="/admin/events" class="btn btn-secondary">← ઇવેન્ટ્સ પર પાછા જાઓ</a>
    </div>
  <% } %>
</div>

<script>
  const eventId = '<%= event ? event.id : "" %>';
  let codeReader = null;

  function startScanner() {
    const video = document.getElementById('video');

    if (!video) {
      showMessage('વિડિયો એલિમેન્ટ મળ્યું નહીં', 'error');
      return;
    }

    video.style.display = 'block';
    document.getElementById('startBtn').style.display = 'none';
    document.getElementById('stopBtn').style.display = 'inline-block';

    // Check for camera permission
    if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
      showMessage('કૅમેરા સપોર્ટેડ નથી. કૃપા કરીને જાતે દાખલ કરો.', 'error');
      return;
    }

    try {
      codeReader = new ZXing.BrowserQRCodeReader();
      codeReader.decodeFromVideoDevice(undefined, 'video', (result, err) => {
        if (result) {
          const qrText = result.text;
          // Extract ID from QR URL (e.g., http://localhost:3000/view/uuid -> uuid)
          const match = qrText.match(/\/view\/([a-f0-9-]+)$/);
          if (match) {
            const recordId = match[1];
            document.getElementById('manualInput').value = recordId;
            performCheckIn();
          }
        }
      });
    } catch (err) {
      showMessage('કૅમેરા ભૂલ: ' + err.message, 'error');
      video.style.display = 'none';
      document.getElementById('startBtn').style.display = 'inline-block';
      document.getElementById('stopBtn').style.display = 'none';
    }
  }

  function stopScanner() {
    const video = document.getElementById('video');
    video.style.display = 'none';
    document.getElementById('startBtn').style.display = 'inline-block';
    document.getElementById('stopBtn').style.display = 'none';

    if (codeReader) {
      codeReader.reset();
    }
  }

  function handleManualInput(e) {
    if (e.key === 'Enter') {
      performCheckIn();
    }
  }

  async function performCheckIn() {
    const recordId = document.getElementById('manualInput').value.trim();
    if (!recordId) {
      showMessage('કૃપા કરીને વપરાશકર્તા ID દાખલ કરો અથવા સ્કેન કરો', 'error');
      return;
    }

    try {
      const response = await fetch('/admin/api/checkin', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ recordId, eventId })
      });

      const data = await response.json();

      if (data.success) {
        showMessage(
          `✓ ${data.record.name} સફળતાપૂર્વક ચેક-ઇન થયા!`,
          'success'
        );
        document.getElementById('manualInput').value = '';
        document.getElementById('manualInput').focus();
        setTimeout(() => location.reload(), 1500);
      } else {
        showMessage(data.error || 'ચેક-ઇન નિષ્ફળ થયું', 'error');
        document.getElementById('manualInput').focus();
      }
    } catch (err) {
      showMessage('ભૂલ: ' + err.message, 'error');
    }
  }

  async function removeCheckIn(recordId) {
    if (!confirm('આ વપરાશકર્તાને હાજરીમાંથી દૂર કરવો છે?')) return;

    try {
      const response = await fetch('/admin/api/checkout', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ recordId, eventId })
      });

      const data = await response.json();
      if (data.success) {
        showMessage(data.message, 'success');
        setTimeout(() => location.reload(), 1000);
      } else {
        showMessage(data.error, 'error');
      }
    } catch (err) {
      showMessage('ભૂલ: ' + err.message, 'error');
    }
  }

  function showMessage(message, type) {
    const container = document.getElementById('messageContainer');
    const className = type === 'success' ? 'success' : 'error';
    container.innerHTML = `<div class="msg-banner ${className}">${message}</div>`;

    if (type === 'success') {
      setTimeout(() => {
        container.innerHTML = '';
      }, 5000);
    }
  }

  // Auto-focus input
  document.addEventListener('DOMContentLoaded', () => {
    const input = document.getElementById('manualInput');
    if (input) input.focus();
  });
</script>

<%- include('partials/footer') %>
