<% var pageTitle = 'Admin Dashboard'; var isAdmin = true; %>
<%- include('partials/header') %>

<div class="wide-container fade-in-up">
  <h1>Admin Dashboard</h1>
  <p class="subtitle">Welcome, <%= adminUsername %>. Below is every user record saved through the registration form.</p>

  <div class="stat-cards">
    <div class="stat-card" style="--d:1; animation-delay:0.05s;">
      <div class="num"><%= total %></div>
      <div class="lbl">Total Registered Users</div>
    </div>
    <div class="stat-card" style="--d:2; animation-delay:0.12s;">
      <div class="num"><%= records.length %></div>
      <div class="lbl">Showing (filtered)</div>
    </div>
  </div>
<div style="margin: 1.5rem 0 2rem; text-align: center;">
  <a href="/admin/events" class="btn">
    📋 Manage Events
  </a>
</div>

  <form class="search-bar" method="GET" action="/admin/dashboard">
    <input type="text" name="search" value="<%= search %>" placeholder="Search by name, location, education, phone or email..." />
    <button type="submit" class="btn">Search</button>
    <% if (search) { %><a href="/admin/dashboard" class="btn btn-secondary">Clear</a><% } %>
    <a href="/admin/dashboard/export<%= search ? '?search=' + encodeURIComponent(search) : '' %>" class="btn btn-secondary">⬇ Export to Excel</a>
  </form>

  <% if (records.length === 0) { %>
    <div class="empty-state card">
      <p>No records found<% if (search) { %> for "<%= search %>"<% } %>.</p>
      <a href="/register" class="btn" style="margin-top:12px;">Open Registration Form</a>
    </div>
  <% } else { %>
    <div class="table-wrap">
      <table class="records-table">
        <thead>
          <tr>
            <th>Actions</th>
            <th>QR</th>
            <th>Name</th>
            <th>Age</th>
            <th>Phone</th>
            <th>WhatsApp</th>
            <th>Area</th>
            <th>Pincode</th>
            <th>House No.</th>
            <th>Society</th>
            <th>Landmark</th>
            <th>Education</th>
            <th>Interest</th>
            <th>Joined Via</th>
            <th>Registered On</th>
          </tr>
        </thead>
        <tbody>
          <% records.forEach(function(r) { %>
            <tr>
              <td>
                <a href="/admin/record/<%= r.id %>" class="btn btn-secondary btn-sm">View</a>
                <a href="<%= r.qrUrl %>" download class="btn btn-secondary btn-sm">QR</a>
                <form action="/admin/delete/<%= r.id %>" method="POST" style="display:inline"
                      onsubmit="return confirm('Delete this record permanently?');">
                  <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                </form>
              </td>
              <td><img src="<%= r.qrUrl %>" class="mini-qr" alt="qr" /></td>
              <td data-label="Name"><%= r.name %></td>
              <td data-label="Age"><%= r.age || '-' %></td>
              <td data-label="Phone"><%= r.phone %></td>
              <td data-label="WhatsApp"><%= r.whatsapp || '-' %></td>
              <td data-label="Area"><%= r.location %></td>
              <td data-label="Pincode"><%= r.pincode %></td>
              <td data-label="House No."><%= r.houseNumber || '-' %></td>
              <td data-label="Society"><%= r.society || '-' %></td>
              <td data-label="Landmark"><%= r.landmark || '-' %></td>
              <td data-label="Education"><%= r.education || '-' %></td>
              <td data-label="Interest"><%= r.interest || '-' %></td>
              <td data-label="Joined Via"><%= r.joinMedium === 'અન્ય' ? (r.joinMediumOther || r.joinMedium) : (r.joinMedium || '-') %></td>
              <td data-label="Registered On"><%= formatShortDate(r.createdAt) %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
  <p class="small-note">Share this registration link with users: <strong><%= baseUrl %>/register</strong></p>
</div>

<%- include('partials/footer') %>
