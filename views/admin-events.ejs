<% var pageTitle = 'ઇવેન્ટ્સ - એડમિન'; %>
<%- include('partials/header') %>

<div class="wide-container fade-in-up">
  <div style="display:flex; justify-content:space-between; align-items:center; gap:12px; flex-wrap:wrap; margin-bottom:20px;">
    <div>
      <h1 style="margin-bottom:4px;">ઇવેન્ટ્સ</h1>
      <p class="subtitle" style="margin-bottom:0;">લોગિન થયેલ છે: <strong><%= adminUsername %></strong></p>
    </div>
    <div class="actions-row" style="margin:0;">
      <% if (adminRole === 'main') { %>
        <a href="/admin/events/export" class="btn btn-secondary">⬇ એક્સેલમાં એક્સપોર્ટ કરો</a>
        <a href="/admin/events/create" class="btn btn-glow">+ નવો ઇવેન્ટ</a>
      <% } %>
    </div>
  </div>

  <% if (events.length === 0) { %>
    <div class="empty-state card">
      <p>હજુ સુધી કોઈ ઇવેન્ટ બનાવવામાં આવ્યો નથી. <a href="/admin/events/create">હમણાં એક બનાવો</a></p>
    </div>
  <% } else { %>
    <% events.forEach(function(event) { %>
      <div class="event-card">
        <div class="event-card-top">
          <div style="flex:1;">
            <h3><%= event.event_name %></h3>
            <p class="event-date">📅 <%= formatEventDateGu(event.event_date) %></p>
            <p class="event-meta">📍 <strong>સ્થળ:</strong> <%= event.location || 'લાગુ પડતું નથી' %></p>
            <% if (event.max_capacity) { %>
              <p class="event-meta">👥 <strong>ક્ષમતા:</strong> <%= event.max_capacity %> વપરાશકર્તાઓ</p>
            <% } %>
            <% if (event.event_description) { %>
              <p class="event-desc"><%= event.event_description %></p>
            <% } %>
          </div>
          <span class="status-badge status-<%= event.status %>">
            <%= event.status === 'upcoming' ? 'આગામી' : event.status === 'ongoing' ? 'ચાલુ છે' : event.status === 'completed' ? 'પૂર્ણ' : event.status.toUpperCase() %>
          </span>
        </div>
        <div class="event-actions">
          <a href="/admin/events/<%= event.id %>" class="btn btn-secondary btn-sm">વિગતો જુઓ</a>
          <a href="/admin/checkin?eventId=<%= event.id %>" class="btn btn-sm">ચેક-ઇન કરો</a>
        </div>
      </div>
    <% }); %>
  <% } %>

  <div style="margin-top:2rem; padding-top:1.5rem; border-top:1px solid var(--border);">
    <a href="/admin/dashboard" class="btn btn-secondary">← ડેશબોર્ડ પર પાછા જાઓ</a>
  </div>
</div>

<%- include('partials/footer') %>
