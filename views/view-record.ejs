<% var pageTitle = record.name + ' - Profile'; %>
<%- include('partials/header') %>

<div class="container">
  <div class="card fade-in-up">
    <div class="profile-header">
      <% if (photoUrl) { %>
        <img src="<%= photoUrl %>" alt="<%= record.name %>" class="record-photo" />
      <% } else { %>
        <div class="record-photo" style="display:flex;align-items:center;justify-content:center;background:#eef2ff;font-size:2rem;">👤</div>
      <% } %>
      <div>
        <h2><%= record.name %></h2>
        <p><%= record.occupation || 'નોંધાયેલ વપરાશકર્તા' %></p>
        <% if (record.phone || record.whatsapp) { %>
          <div class="quick-contact" style="margin-top:8px;">
            <% if (record.phone) { %>
              <a href="tel:<%= record.phone %>" class="call-link">📞 કૉલ કરો</a>
            <% } %>
            <% var waNumber = (record.whatsapp || record.phone || '').replace(/\D/g, ''); %>
            <% if (waNumber) { %>
              <a href="https://wa.me/91<%= waNumber %>" target="_blank" rel="noopener" class="whatsapp-link">💬 WhatsApp</a>
            <% } %>
          </div>
        <% } %>
      </div>
    </div>

    <div class="detail-row"><span class="label">ઉંમર</span><span class="value"><%= record.age || '-' %></span></div>
    <div class="detail-row"><span class="label">ફોન નંબર</span><span class="value"><%= record.phone || '-' %></span></div>
    <div class="detail-row"><span class="label">વોટ્સએપ નંબર</span><span class="value"><%= record.whatsapp || '-' %></span></div>
    <div class="detail-row"><span class="label">એરિયા</span><span class="value"><%= (record.location === 'અન્ય' ? (record.locationOther || record.location) : record.location) || '-' %></span></div>
    <div class="detail-row"><span class="label">પિનકોડ</span><span class="value"><%= record.pincode || '-' %></span></div>
    <div class="detail-row"><span class="label">ઘર નંબર</span><span class="value"><%= record.houseNumber || '-' %></span></div>
    <div class="detail-row"><span class="label">સોસાયટી</span><span class="value"><%= record.society || '-' %></span></div>
    <div class="detail-row"><span class="label">લેન્ડમાર્ક</span><span class="value"><%= record.landmark || '-' %></span></div>
    <div class="detail-row"><span class="label">અભ્યાસ</span><span class="value"><%= record.education || '-' %></span></div>
    <div class="detail-row"><span class="label">રુચિનો વિષય</span><span class="value"><%= record.interest || '-' %></span></div>
    <div class="detail-row"><span class="label">કયા માધ્યમથી જોડાયા</span><span class="value"><%= record.joinMedium === 'અન્ય' ? (record.joinMediumOther || record.joinMedium) : (record.joinMedium || '-') %></span></div>
    <% if (record.email) { %>
    <div class="detail-row"><span class="label">ઈમેલ</span><span class="value"><%= record.email %></span></div>
    <% } %>
    <% if (record.dob) { %>
    <div class="detail-row"><span class="label">જન્મ તારીખ</span><span class="value"><%= record.dob %></span></div>
    <% } %>
    <% if (record.gender) { %>
    <div class="detail-row"><span class="label">લિંગ</span><span class="value"><%= record.gender %></span></div>
    <% } %>
    <% if (record.address) { %>
    <div class="detail-row"><span class="label">સરનામું</span><span class="value"><%= record.address %></span></div>
    <% } %>
<% if (record.notes) { %>
      <div class="detail-row"><span class="label">નોંધ</span><span class="value"><%= record.notes %></span></div>
    <% } %>
    <div class="detail-row"><span class="label">નોંધણી તારીખ</span><span class="value"><%= formatDateTimeGu(record.createdAt) %></span></div>

<% if (isAdmin && attendanceHistory && attendanceHistory.length > 0) { %>
  <div style="margin-top: 2rem; padding-top: 2rem; border-top: 1px solid var(--border);">
    <h3>📊 હાજરી ઇતિહાસ</h3>
    <ul style="list-style: none; padding: 0;">
      <% attendanceHistory.forEach(event => { %>
        <li style="
          padding: 0.75rem;
          margin-bottom: 0.5rem;
          background: var(--primary-light);
          border-left: 4px solid var(--primary);
          border-radius: var(--radius-sm);
        ">
          <strong><%= event.event_name %></strong><br>
          📅 <%= formatShortDateGu(event.event_date) %><br>
          📍 <%= event.location %><br>
          <small style="color: var(--text-light);">✓ ચેક-ઇન: <%= formatDateTimeGu(event.checked_in_at) %></small>
        </li>
      <% }); %>
    </ul>
  </div>
<% } %>

    <% if (isAdmin) { %>
      <div class="actions-row">
        <img src="<%= qrUrl %>" class="mini-qr" alt="qr" style="width:60px;height:60px;" />
        <a href="<%= qrUrl %>" download="qr-<%= record.name.replace(/\s+/g,'-') %>.png" class="btn btn-secondary">⬇ QR ડાઉનલોડ</a>
        <% if (typeof adminRole !== 'undefined' && adminRole === 'main' && record.email) { %>
          <button type="button" id="send-qr-btn" class="btn btn-secondary" onclick="sendQrEmail()">📧 QR Email મોકલો</button>
        <% } %>
        <a href="/admin/dashboard" class="btn btn-secondary">← ડેશબોર્ડ</a>
        <% if (typeof adminRole !== 'undefined' && adminRole === 'main') { %>
          <a href="/admin/record/<%= record.id %>/edit" class="btn btn-secondary">✏️ ફેરફાર કરો</a>
        <% } %>
        <% if (typeof adminRole !== 'undefined' && adminRole === 'main') { %>
          <form action="/admin/delete/<%= record.id %>" method="POST" style="display:inline;"
                onsubmit="return confirm('આ રેકોર્ડ કાયમ માટે ડિલીટ કરવો છે?');">
            <button type="submit" class="btn btn-danger">ડિલીટ</button>
          </form>
        <% } %>
      </div>
      <% if (typeof adminRole !== 'undefined' && adminRole === 'main' && record.email) { %>
      <div id="qr-send-result" style="display:none;margin-top:10px;" class="alert"></div>
      <script>
        function sendQrEmail() {
          var btn = document.getElementById('send-qr-btn');
          var result = document.getElementById('qr-send-result');
          btn.disabled = true; btn.textContent = '⏳ Sending...';
          fetch('/admin/send-qr/<%= record.id %>', { method: 'POST', headers: { 'Content-Type': 'application/json' } })
            .then(function(r){ return r.json(); })
            .then(function(data) {
              btn.disabled = false; btn.textContent = '📧 QR Email મોકલો';
              result.style.display = '';
              result.className = 'alert ' + (data.success ? 'alert-success' : 'alert-error');
              result.textContent = data.success ? '✅ QR Email sent to ' + <%- JSON.stringify(record.email) %> : '❌ ' + (data.error || 'Failed');
            })
            .catch(function(e) {
              btn.disabled = false; btn.textContent = '📧 QR Email મોકલો';
              result.style.display = ''; result.className = 'alert alert-error';
              result.textContent = '❌ Network error';
            });
        }
      </script>
      <% } %>
    <% } %>
  </div>
</div>

<%- include('partials/footer') %>
