<% var pageTitle = record.name + ' - Profile'; %>
<%- include('partials/header') %>

<div class="container">
  <div class="card">
    <div class="profile-header">
      <% if (photoUrl) { %>
        <img src="<%= photoUrl %>" alt="<%= record.name %>" class="record-photo" />
      <% } else { %>
        <div class="record-photo" style="display:flex;align-items:center;justify-content:center;background:#eef2ff;font-size:2rem;">👤</div>
      <% } %>
      <div>
        <h2><%= record.name %></h2>
        <p><%= record.occupation || 'Registered User' %></p>
      </div>
    </div>

    <div class="detail-row"><span class="label">Location</span><span class="value"><%= record.location || '-' %></span></div>
    <div class="detail-row"><span class="label">Education</span><span class="value"><%= record.education || '-' %></span></div>
    <div class="detail-row"><span class="label">Phone</span><span class="value"><%= record.phone || '-' %></span></div>
    <div class="detail-row"><span class="label">Email</span><span class="value"><%= record.email || '-' %></span></div>
    <div class="detail-row"><span class="label">Date of Birth</span><span class="value"><%= record.dob || '-' %></span></div>
    <div class="detail-row"><span class="label">Gender</span><span class="value"><%= record.gender || '-' %></span></div>
    <div class="detail-row"><span class="label">Address</span><span class="value"><%= record.address || '-' %></span></div>
    <div class="detail-row"><span class="label">PinCode</span><span class="value"><%= record.pincode || '-' %></span></div>
<% if (record.notes) { %>
      <div class="detail-row"><span class="label">Notes</span><span class="value"><%= record.notes %></span></div>
    <% } %>
    <div class="detail-row"><span class="label">Registered On</span><span class="value"><%= new Date(record.createdAt).toLocaleString() %></span></div>

    <% if (isAdmin) { %>
      <div class="actions-row">
        <img src="<%= qrUrl %>" class="mini-qr" alt="qr" style="width:60px;height:60px;" />
        <a href="/admin/dashboard" class="btn btn-secondary">Back to Dashboard</a>
      </div>
    <% } %>
  </div>
</div>

<%- include('partials/footer') %>
