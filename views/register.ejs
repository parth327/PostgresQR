<script>
  (function () {
    var form = document.getElementById('regForm');
    var btn = document.getElementById('submitBtn');
    var progressFill = document.getElementById('progressFill');
    var progressLabel = document.getElementById('progressLabel');

    var joinMedium = document.getElementById('joinMedium');
    var otherWrap = document.getElementById('joinMediumOtherWrap');
    var otherInput = document.getElementById('joinMediumOther');

    var location = document.getElementById('f-location');
    var locationOtherWrap = document.getElementById('locationOtherWrap');
    var locationOtherInput = document.getElementById('f-locationOther');

    function syncConditional(select, wrap, input) {
      var isOther = select.value === 'અન્ય';
      wrap.style.display = isOther ? 'block' : 'none';
      if (isOther) {
        input.setAttribute('required', 'required');
        requestAnimationFrame(function () { wrap.classList.add('field-reveal'); });
      } else {
        input.removeAttribute('required');
        input.value = '';
        wrap.classList.remove('field-reveal');
      }
      updateProgress();
    }

    function syncOther() {
      syncConditional(joinMedium, otherWrap, otherInput);
    }

    function syncLocationOther() {
      syncConditional(location, locationOtherWrap, locationOtherInput);
    }

    // Required, currently-visible fields we track for the progress bar / validity
    function requiredFields() {
      var fields = Array.prototype.slice.call(form.querySelectorAll('[required]'));
      return fields.filter(function (el) {
        return el.offsetParent !== null; // ignore required fields hidden in a collapsed section
      });
    }

    function fieldIsValid(el) {
      if (el.tagName === 'SELECT') return !!el.value;
      if (el.type === 'number') {
        var v = parseInt(el.value, 10);
        var min = el.min ? parseInt(el.min, 10) : -Infinity;
        var max = el.max ? parseInt(el.max, 10) : Infinity;
        return el.value !== '' && !isNaN(v) && v >= min && v <= max;
      }
      if (el.pattern) {
        return new RegExp('^(?:' + el.pattern + ')$').test(el.value);
      }
      return el.value.trim().length > 0;
    }

    function updateProgress() {
      var fields = requiredFields();
      var filled = fields.filter(fieldIsValid).length;
      var pct = fields.length ? Math.round((filled / fields.length) * 100) : 0;
      progressFill.style.width = pct + '%';
      var pctSuffix = document.documentElement.getAttribute('lang') === 'en' ? '% Complete' : '% પૂર્ણ';
      progressLabel.textContent = pct + pctSuffix;
      btn.disabled = pct < 100;
    }

    function attachHint(el) {
      el.addEventListener('input', function () {
        el.classList.remove('field-error', 'field-ok');
        updateProgress();
      });
      el.addEventListener('blur', function () {
        if (!el.hasAttribute('required') && el.value.trim() === '') return;
        if (fieldIsValid(el)) {
          el.classList.add('field-ok');
          el.classList.remove('field-error');
        } else {
          el.classList.add('field-error');
          el.classList.remove('field-ok');
        }
      });
    }

    Array.prototype.slice.call(form.querySelectorAll('input, select, textarea')).forEach(attachHint);

    joinMedium.addEventListener('change', syncOther);
    location.addEventListener('change', syncLocationOther);
    syncOther();
    syncLocationOther();
    updateProgress();

    form.addEventListener('submit', function (e) {
      if (!form.checkValidity()) {
        e.preventDefault();
        var firstInvalid = form.querySelector(':invalid');
        if (firstInvalid) {
          firstInvalid.classList.add('field-error');
          firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
          firstInvalid.focus();
        }
        return;
      }
      btn.classList.add('loading');
      btn.disabled = true;
    });
  })();
</script>

