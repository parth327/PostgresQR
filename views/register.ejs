<section class="ys-quote-section ys-reveal">
  <div class="ys-quote-box">
    <p class="ys-quote-text" data-i18n="quote-text">"યુવા કેવળ ભવિષ્ય નથી, વર્તમાનની શક્તિ છે.."</p>
  </div>
</section>

<section class="ys-youngsters-section ys-reveal">
  <div class="ys-youngsters-container">
    <img src="/img/ys-youngsters.jpg" alt="Youngsters of India" class="ys-youngsters-img" />
    <div class="ys-youngsters-glow"></div>
  </div>
</section>

<!-- ===================================================================
     All Event Details (dynamic) — all events from the database shown as
     compact cards between the youngsters image and the registration form.
     =================================================================== -->
<% if (typeof events !== 'undefined' && events && events.length > 0) { %>
<section class="ys-event-details-section ys-reveal" id="ys-event-details">

  <div class="all-events-grid">
  <% events.forEach(function(ev, idx) {
       var evDateISO = ev.event_date
         ? (ev.event_date instanceof Date ? ev.event_date.toISOString().split('T')[0] : String(ev.event_date).split('T')[0])
         : '';
  %>
    <div class="event-mini-card">
      <div class="event-mini-header">
        <span class="event-mini-badge status-<%= ev.status %>">
          <%= ev.status === 'upcoming' ? 'આગામી' : ev.status === 'ongoing' ? 'ચાલુ' : ev.status === 'completed' ? 'પૂર્ણ' : (ev.status || 'આગામી') %>
        </span>
        <h3 class="event-mini-name"><%= ev.event_name %></h3>
      </div>
      <div class="event-mini-rows">
        <div class="event-mini-row">
          <span class="event-mini-icon">📅</span>
          <span><%= formatEventDateGu(ev.event_date) %><% if (ev.event_time) { %> &nbsp;•&nbsp; 🕒 <%= ev.event_time %><% } %></span>
        </div>
        <% if (ev.location) { %>
        <div class="event-mini-row">
          <span class="event-mini-icon">📍</span>
          <span><%= ev.location %></span>
        </div>
        <% } %>
        <% if (ev.contact1_name || ev.contact2_name) { %>
        <div class="event-mini-row">
          <span class="event-mini-icon">📞</span>
          <span>
            <% if (ev.contact1_name) { %><%= ev.contact1_name %><% if (ev.contact1_mobile) { %> — <a href="tel:<%= ev.contact1_mobile %>"><%= ev.contact1_mobile %></a><% } %><% } %>
            <% if (ev.contact1_name && ev.contact2_name) { %> &nbsp;|&nbsp; <% } %>
            <% if (ev.contact2_name) { %><%= ev.contact2_name %><% if (ev.contact2_mobile) { %> — <a href="tel:<%= ev.contact2_mobile %>"><%= ev.contact2_mobile %></a><% } %><% } %>
          </span>
        </div>
        <% } %>
      </div>
      <% if (idx === 0 && evDateISO) { %>
      <div class="event-mini-countdown" id="ysCountdown" data-target-date="<%= evDateISO %>" data-target-time="<%= ev.event_time || '00:00' %>">
        <div class="cdb"><span class="cdn" id="cdDays">00</span><span class="cdl">દિવસ</span></div>
        <div class="cdb"><span class="cdn" id="cdHours">00</span><span class="cdl">કલાક</span></div>
        <div class="cdb"><span class="cdn" id="cdMins">00</span><span class="cdl">મિ.</span></div>
        <div class="cdb"><span class="cdn" id="cdSecs">00</span><span class="cdl">સે.</span></div>
      </div>
      <% } %>
    </div>
  <% }); %>
  </div>

</section>
<% } %>

<!-- ===================================================================
     Existing registration form (unchanged below — now appears after the
     landing content above; only data-i18n attributes were added to its
     text so the language switch can translate it too).
     =================================================================== -->

<div class="container">
  <div class="card fade-in-up">
    <div class="form-hero">
      <h2 class="hero-badge" data-i18n="reg-heading-badge">🕉️ રાષ્ટ્રીય સ્વયંસેવક સંઘ - નરોડા ભાગ 🕉️</h2>
      <h1 data-i18n="reg-heading-title">યુવા સંગમ ૨૦૨૬</h1>
      <p class="subtitle" data-i18n="reg-heading-subtitle">નમસ્તે મિત્રો, યુવા સંગમમાં જોડાવા માટે નીચે આપેલ માહિતી ભરશો!!!</p>
    </div>

    <div class="progress-track" aria-hidden="true">
      <div class="progress-fill" id="progressFill"></div>
    </div>
    <p class="progress-label" id="progressLabel" data-i18n-suffix>0% પૂર્ણ</p>

    <% if (error) { %>
      <div class="alert alert-error shake">⚠️ <%= error %></div>
    <% } %>

    <form action="/register" method="POST" enctype="multipart/form-data" id="regForm" novalidate>

      <div class="form-section stagger" style="--d:1">
        <h3 class="section-title"><span class="section-num">1</span> <span data-i18n="sec-1-title">વ્યક્તિગત માહિતી</span></h3>
        <div class="form-grid">
          <div class="field full">
            <label for="f-name"><span data-i18n="lbl-name">👤 પૂરું નામ</span> <span class="req">*</span></label>
            <input type="text" id="f-name" name="name" required value="<%= formData.name || '' %>" placeholder="દા.ત. રમેશ પટેલ" data-i18n-placeholder="ph-name" />
          </div>

          <div class="field">
            <label for="f-age"><span data-i18n="lbl-age">🎂 ઉંમર</span> <span class="req">*</span></label>
            <input type="number" id="f-age" name="age" required min="15" max="100" value="<%= formData.age || '' %>" placeholder="15 - 100" data-i18n-placeholder="ph-age" />
          </div>

          <div class="field">
            <label for="f-education"><span data-i18n="lbl-education">🎓 અભ્યાસ</span> <span class="req">*</span></label>
            <input type="text" id="f-education" name="education" required value="<%= formData.education || '' %>" placeholder="દા.ત. B.Tech Computer Science" data-i18n-placeholder="ph-education" />
          </div>
        </div>
      </div>

      <div class="form-section stagger" style="--d:2">
        <h3 class="section-title"><span class="section-num">2</span> <span data-i18n="sec-2-title">સંપર્ક વિગતો</span></h3>
        <div class="form-grid">
          <div class="field">
            <label for="f-phone"><span data-i18n="lbl-phone">📱 ફોન નંબર</span> <span class="req">*</span></label>
            <input type="tel" id="f-phone" name="phone" required inputmode="numeric" pattern="[0-9]{10}" maxlength="10" value="<%= formData.phone || '' %>" placeholder="દા.ત. 9876543210" data-i18n-placeholder="ph-phone" />
          </div>

          <div class="field">
            <label for="f-whatsapp" data-i18n="lbl-whatsapp">💬 વોટ્સએપ નંબર (જો હોય તો)</label>
            <input type="tel" id="f-whatsapp" name="whatsapp" inputmode="numeric" pattern="[0-9]{10}" maxlength="10" value="<%= formData.whatsapp || '' %>" placeholder="દા.ત. 9876543210" data-i18n-placeholder="ph-whatsapp" />
          </div>

          <div class="field">
            <label for="f-email"><span data-i18n="lbl-email">📧 ઈમેલ</span> <span class="req">*</span></label>
            <input type="email" id="f-email" name="email" required value="<%= formData.email || '' %>" placeholder="દા.ત. name@example.com" data-i18n-placeholder="ph-email" />
            <small class="field-hint" data-i18n="hint-email">તમારો QR કોડ આ ઈમેલ પર મોકલવામાં આવશે.</small>
          </div>
        </div>
      </div>

      <div class="form-section stagger" style="--d:3">
        <h3 class="section-title"><span class="section-num">3</span> <span data-i18n="sec-3-title">સરનામું</span></h3>
        <div class="form-grid">
          <div class="field">
            <label for="f-location"><span data-i18n="lbl-location">📍 એરિયા</span> <span class="req">*</span></label>
            <select id="f-location" name="location" required data-i18n-options>
              <option value="" disabled <%= !formData.location ? 'selected' : '' %> data-i18n="opt-select">પસંદ કરો</option>
              <% ['કૃષ્ણા નગર','કુબેરનગર','સૈજપુર','સરદારનગર','નરોડા','હરિદર્શન','અન્ય'].forEach(function(opt) { %>
                <option value="<%= opt %>" <%= formData.location === opt ? 'selected' : '' %>><%= opt %></option>
              <% }); %>
            </select>
          </div>

          <div class="field full" id="locationOtherWrap" style="display:none;">
            <label for="f-locationOther"><span data-i18n="lbl-location-other">📍 અન્ય એરિયા</span> <span class="req">*</span></label>
            <input type="text" id="f-locationOther" name="locationOther" value="<%= formData.locationOther || '' %>" placeholder="કૃપા કરીને તમારો એરિયા જણાવો" data-i18n-placeholder="ph-location-other" />
          </div>

          <div class="field">
            <label for="f-pincode"><span data-i18n="lbl-pincode">🏷️ પિનકોડ</span> <span class="req">*</span></label>
            <input type="text" id="f-pincode" name="pincode" required inputmode="numeric" maxlength="6" value="<%= formData.pincode || '' %>" placeholder="દા.ત. 382330" data-i18n-placeholder="ph-pincode" />
          </div>

          <div class="field">
            <label for="f-houseNumber" data-i18n="lbl-houseNumber">🏠 ઘર નંબર</label>
            <input type="text" id="f-houseNumber" name="houseNumber" value="<%= formData.houseNumber || '' %>" placeholder="દા.ત. 12/A" data-i18n-placeholder="ph-houseNumber" />
          </div>

          <div class="field">
            <label for="f-society" data-i18n="lbl-society">🏘️ સોસાયટી</label>
            <input type="text" id="f-society" name="society" value="<%= formData.society || '' %>" placeholder="સોસાયટીનું નામ" data-i18n-placeholder="ph-society" />
          </div>

          <div class="field full">
            <label for="f-landmark" data-i18n="lbl-landmark">🧭 લેન્ડમાર્ક</label>
            <input type="text" id="f-landmark" name="landmark" value="<%= formData.landmark || '' %>" placeholder="નજીકનું જાણીતું સ્થળ" data-i18n-placeholder="ph-landmark" />
          </div>
        </div>
      </div>

      <div class="form-section stagger" style="--d:4">
