<% var pageTitle = 'Register - YUVA SANGAM 2026'; %>
<%- include('partials/header') %>

<div class="container">
  <div class="card fade-in-up">
    <div class="form-hero">
      <h2 class="hero-badge">🕉️રાષ્ટ્રીય સ્વયંસેવક સંઘ🕉️</h2>
      <h1>યુવા સંગમ ૨૦૨૬</h1>
      <p class="subtitle">નમસ્તે મિત્રો , યુવા સંગમમાં જોડાવા માટે નીચે આપેલ માહિતી ભરશો!!!</p>
    </div>

    <% if (error) { %>
      <div class="alert alert-error shake"><%= error %></div>
    <% } %>

    <form action="/register" method="POST" enctype="multipart/form-data" id="regForm" novalidate>
      <div class="form-grid">

        <div class="field full stagger" style="--d:1">
          <label>પૂરું નામ <span class="req">*</span></label>
          <input type="text" name="name" required value="<%= formData.name || '' %>" placeholder="દા.ત. રમેશ પટેલ" />
        </div>

        <div class="field stagger" style="--d:2">
          <label>ફોન નંબર <span class="req">*</span></label>
          <input type="tel" name="phone" required pattern="[0-9]{10}" maxlength="10" value="<%= formData.phone || '' %>" placeholder="દા.ત. 9876543210" />
        </div>

        <div class="field stagger" style="--d:3">
          <label>વોટ્સએપ નંબર</label>
          <input type="tel" name="whatsapp" pattern="[0-9]{10}" maxlength="10" value="<%= formData.whatsapp || '' %>" placeholder="દા.ત. 9876543210" />
        </div>

        <div class="field stagger" style="--d:4">
          <label>ઉંમર <span class="req">*</span></label>
          <input type="number" name="age" required min="15" max="100" value="<%= formData.age || '' %>" placeholder="15 - 100" />
        </div>

        <div class="field stagger" style="--d:5">
          <label>એરિયા <span class="req">*</span></label>
          <select name="location" required>
            <option value="" disabled <%= !formData.location ? 'selected' : '' %>>પસંદ કરો</option>
            <% ['કૃષ્ણા નગર','કુબેરનગર','સૈજપુર','સરદારનગર','નરોડા','હરિદર્શન'].forEach(function(opt) { %>
              <option value="<%= opt %>" <%= formData.location === opt ? 'selected' : '' %>><%= opt %></option>
            <% }); %>
          </select>
        </div>

        <div class="field stagger" style="--d:6">
          <label>પિનકોડ <span class="req">*</span></label>
          <input type="text" name="pincode" required value="<%= formData.pincode || '' %>" placeholder="દા.ત. 382330" />
        </div>

        <div class="field stagger" style="--d:7">
          <label>ઘર નંબર</label>
          <input type="text" name="houseNumber" value="<%= formData.houseNumber || '' %>" placeholder="દા.ત. 12/A" />
        </div>

        <div class="field stagger" style="--d:8">
          <label>સોસાયટી</label>
          <input type="text" name="society" value="<%= formData.society || '' %>" placeholder="સોસાયટીનું નામ" />
        </div>

        <div class="field full stagger" style="--d:9">
          <label>લેન્ડમાર્ક</label>
          <input type="text" name="landmark" value="<%= formData.landmark || '' %>" placeholder="નજીકનું જાણીતું સ્થળ" />
        </div>

        <div class="field stagger" style="--d:10">
          <label>અભ્યાસ <span class="req">*</span></label>
          <input type="text" name="education" required value="<%= formData.education || '' %>" placeholder="દા.ત. B.Tech Computer Science" />
        </div>

        <div class="field stagger" style="--d:11">
          <label>રુચિનો વિષય <span class="req">*</span></label>
          <select name="interest" required>
            <option value="" disabled <%= !formData.interest ? 'selected' : '' %>>પસંદ કરો</option>
            <% ['સેવા','પર્યાવરણ','વાંચન','લેખન','વક્તા','રમત'].forEach(function(opt) { %>
              <option value="<%= opt %>" <%= formData.interest === opt ? 'selected' : '' %>><%= opt %></option>
            <% }); %>
          </select>
        </div>

        <div class="field full stagger" style="--d:12">
          <label>કયા માધ્યમથી યુવા સંગમ માં જોડાવાના છો? <span class="req">*</span></label>
          <select name="joinMedium" id="joinMedium" required>
            <option value="" disabled <%= !formData.joinMedium ? 'selected' : '' %>>પસંદ કરો</option>
            <% ['શાખા','સાપ્તાહિક મિલન','અન્ય'].forEach(function(opt) { %>
              <option value="<%= opt %>" <%= formData.joinMedium === opt ? 'selected' : '' %>><%= opt %></option>
            <% }); %>
          </select>
        </div>

        <div class="field full stagger" id="joinMediumOtherWrap" style="--d:13; display:none;">
          <label>અન્ય <span class="req">*</span></label>
          <input type="text" name="joinMediumOther" id="joinMediumOther" value="<%= formData.joinMediumOther || '' %>" placeholder="કૃપા કરીને જણાવો" />
        </div>

        <div class="field" style="display:none;">
          <label>Date of Birth</label>
          <input type="date" name="dob" value="<%= formData.dob || '' %>" />
        </div>

        <div class="field" style="display:none;">
          <label>Email</label>
          <input type="email" name="email" value="<%= formData.email || '' %>" placeholder="e.g. john@email.com" />
        </div>

        <div class="field" style="display:none;">
          <label>Gender</label>
          <select name="gender">
            <option value="">Select</option>
            <option value="Male" <%= formData.gender === 'Male' ? 'selected' : '' %>>Male</option>
            <option value="Female" <%= formData.gender === 'Female' ? 'selected' : '' %>>Female</option>
            <option value="Other" <%= formData.gender === 'Other' ? 'selected' : '' %>>Other</option>
          </select>
        </div>

        <div class="field full" style="display:none;">
          <label>Address</label>
          <input type="text" name="address" value="<%= formData.address || '' %>" placeholder="Full address" />
        </div>

        <div class="field" style="display:none;">
          <label>Occupation</label>
          <input type="text" name="occupation" value="<%= formData.occupation || '' %>" placeholder="e.g. Software Engineer" />
        </div>

        <div class="field" style="display:none;">
          <label>Photo (optional)</label>
          <input type="file" name="photo" accept="image/*" />
        </div>

        <div class="field full" style="display:none;">
          <label>Additional Notes</label>
          <textarea name="notes" placeholder="Anything else you'd like to add..."><%= formData.notes || '' %></textarea>
        </div>
      </div>

      <div class="actions-row">
        <button type="submit" class="btn btn-block btn-glow" id="submitBtn">
          <span class="btn-text">ક્લિક કરો અને તમારો ક્યુઆર કોડ જનરેટ કરો</span>
          <span class="btn-spinner" aria-hidden="true"></span>
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  (function () {
    var joinMedium = document.getElementById('joinMedium');
    var otherWrap = document.getElementById('joinMediumOtherWrap');
    var otherInput = document.getElementById('joinMediumOther');

    function syncOther() {
      var isOther = joinMedium.value === 'અન્ય';
      otherWrap.style.display = isOther ? 'block' : 'none';
      if (isOther) {
        otherInput.setAttribute('required', 'required');
        requestAnimationFrame(function () { otherWrap.classList.add('field-reveal'); });
      } else {
        otherInput.removeAttribute('required');
        otherInput.value = '';
        otherWrap.classList.remove('field-reveal');
      }
    }

    joinMedium.addEventListener('change', syncOther);
    syncOther();

    var form = document.getElementById('regForm');
    var btn = document.getElementById('submitBtn');
    form.addEventListener('submit', function () {
      if (form.checkValidity()) {
        btn.classList.add('loading');
        btn.disabled = true;
      }
    });
  })();
</script>

<%- include('partials/footer') %>
