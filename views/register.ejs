          <div class="field full">
            <label for="joinMedium"><span data-i18n="lbl-joinMedium">🤝 કયા માધ્યમથી યુવા સંગમ માં જોડાવાના છો?</span> <span class="req">*</span></label>
            <select name="joinMedium" id="joinMedium" required data-i18n-options>
              <option value="" disabled <%= !formData.joinMedium ? 'selected' : '' %> data-i18n="opt-select">પસંદ કરો</option>
              <% ['શાખા','સાપ્તાહિક મિલન','અન્ય'].forEach(function(opt) { %>
                <option value="<%= opt %>" <%= formData.joinMedium === opt ? 'selected' : '' %>><%= opt %></option>
              <% }); %>
            </select>
          </div>

          <div class="field full" id="joinMediumOtherWrap" style="display:none;">
            <label for="joinMediumOther"><span data-i18n="lbl-joinMedium-other">✍️ અન્ય</span> <span class="req">*</span></label>
            <input type="text" name="joinMediumOther" id="joinMediumOther" value="<%= formData.joinMediumOther || '' %>" placeholder="કૃપા કરીને જણાવો" data-i18n-placeholder="ph-joinMedium-other" />
