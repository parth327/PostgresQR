<div class="audio-control" id="audio-toggle" title="સંગીત ચાલુ/બંધ કરો">
  <svg class="volume-on" viewBox="0 0 24 24" fill="currentColor"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/></svg>
  <svg class="volume-off hidden" viewBox="0 0 24 24" fill="currentColor"><path d="M16.5 12A4.5 4.5 0 0014 7.97v1.79l2.48 2.48c.01-.08.02-.16.02-.24zM19 12c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z"/></svg>
</div>
<script>
  // Initialise audio toggle for register page
  (function () {
    var audio = document.getElementById('ambient-audio');
    var toggle = document.getElementById('audio-toggle');
    if (!audio || !toggle) return;
    var on = toggle.querySelector('.volume-on');
    var off = toggle.querySelector('.volume-off');
    // Browsers block autoplay — try to play immediately, show correct icon state
    function setIcon(playing) {
      if (playing) { on.classList.remove('hidden'); off.classList.add('hidden'); }
      else { on.classList.add('hidden'); off.classList.remove('hidden'); }
    }
    audio.play().then(function () { setIcon(true); }).catch(function () { setIcon(false); });
    toggle.addEventListener('click', function () {
      if (audio.paused) { audio.play(); setIcon(true); }
      else { audio.pause(); setIcon(false); }
    });
  })();
</script>

<script src="/js/i18n.js"></script>

<script>
  // Live countdown for the "Event Details" card — target is the event's
  // date + time, always interpreted as India Standard Time (+05:30),
  // regardless of the visitor's own timezone.
  (function () {
    var el = document.getElementById('ysCountdown');
    if (!el) return;

    var dateStr = el.getAttribute('data-target-date');
    var timeStr = el.getAttribute('data-target-time') || '00:00';
    if (!dateStr) return;

    var target = new Date(dateStr + 'T' + timeStr + ':00+05:30');
    var dEl = document.getElementById('cdDays');
    var hEl = document.getElementById('cdHours');
    var mEl = document.getElementById('cdMins');
    var sEl = document.getElementById('cdSecs');

    function pad(n) { return String(n).padStart(2, '0'); }

    function tick() {
      var diff = target.getTime() - Date.now();
      if (diff < 0) diff = 0;
      var days = Math.floor(diff / (1000 * 60 * 60 * 24));
      var hours = Math.floor((diff / (1000 * 60 * 60)) % 24);
      var mins = Math.floor((diff / (1000 * 60)) % 60);
      var secs = Math.floor((diff / 1000) % 60);
      dEl.textContent = pad(days);
      hEl.textContent = pad(hours);
      mEl.textContent = pad(mins);
      sEl.textContent = pad(secs);
    }

    tick();
    setInterval(tick, 1000);
  })();

  (function () {
    var form = document.getElementById('regForm');
    var btn = document.getElementById('submitBtn');
    var progressFill = document.getElementById('progressFill');
    var progressLabel = document.getElementById('progressLabel');

    var joinMedium = document.getElementById('joinMedium');
    var otherWrap = document.getElementById('joinMediumOtherWrap');
    var otherInput = document.getElementById('joinMediumOther');

    var location = document.getElementById('f-location');
    var locationOtherWrap = document.getElementById('locationOtherWrap');
    var locationOtherInput = document.getElementById('f-locationOther');

    // Validation error message element (created once)
    var validationBanner = document.createElement('div');
    validationBanner.className = 'alert alert-error shake';
    validationBanner.style.display = 'none';
    form.insertBefore(validationBanner, form.firstChild);

    function syncConditional(select, wrap, input) {
      var isOther = select.value === 'અન્ય';
      wrap.style.display = isOther ? 'block' : 'none';
      if (isOther) {
        input.setAttribute('required', 'required');
        requestAnimationFrame(function () { wrap.classList.add('field-reveal'); });
      } else {
        input.removeAttribute('required');
        input.value = '';
        wrap.classList.remove('field-reveal');
      }
      updateProgress();
    }

    function syncOther() { syncConditional(joinMedium, otherWrap, otherInput); }
    function syncLocationOther() { syncConditional(location, locationOtherWrap, locationOtherInput); }

    function requiredFields() {
      var fields = Array.prototype.slice.call(form.querySelectorAll('[required]'));
      return fields.filter(function (el) { return el.offsetParent !== null; });
    }

    function fieldIsValid(el) {
      if (el.tagName === 'SELECT') return !!el.value;
      if (el.type === 'number') {
        var v = parseInt(el.value, 10);
        var min = el.min ? parseInt(el.min, 10) : -Infinity;
        var max = el.max ? parseInt(el.max, 10) : Infinity;
        return el.value !== '' && !isNaN(v) && v >= min && v <= max;
      }
      if (el.type === 'email') {
        return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(el.value.trim());
      }
      if (el.pattern) {
        return new RegExp('^(?:' + el.pattern + ')$').test(el.value);
      }
      return el.value.trim().length > 0;
    }

    function fieldLabel(el) {
      var label = form.querySelector('label[for="' + el.id + '"]');
      if (label) return label.innerText.replace('*', '').trim().replace(/^[^\w\u0A80-\u0AFF]+/, '');
      return el.name || el.id;
    }

    function updateProgress() {
      var fields = requiredFields();
      var filled = fields.filter(fieldIsValid).length;
      var pct = fields.length ? Math.round((filled / fields.length) * 100) : 0;
      progressFill.style.width = pct + '%';
      var pctSuffix = document.documentElement.getAttribute('lang') === 'en' ? '% Complete' : '% પૂર્ણ';
      progressLabel.textContent = pct + pctSuffix;
      // Button always enabled — validation shown on click
    }

    function attachHint(el) {
      el.addEventListener('input', function () {
        el.classList.remove('field-error', 'field-ok');
        updateProgress();
      });
      el.addEventListener('blur', function () {
        if (!el.hasAttribute('required') && el.value.trim() === '') return;
        if (fieldIsValid(el)) {
          el.classList.add('field-ok'); el.classList.remove('field-error');
        } else {
          el.classList.add('field-error'); el.classList.remove('field-ok');
        }
      });
    }

    Array.prototype.slice.call(form.querySelectorAll('input, select, textarea')).forEach(attachHint);

    joinMedium.addEventListener('change', syncOther);
    location.addEventListener('change', syncLocationOther);
    syncOther();
    syncLocationOther();
    updateProgress();

    form.addEventListener('submit', function (e) {
      // Mark all invalid required fields
      var fields = requiredFields();
      var invalid = fields.filter(function (el) { return !fieldIsValid(el); });

      if (invalid.length > 0) {
        e.preventDefault();
        // Mark each invalid field
        invalid.forEach(function (el) {
          el.classList.add('field-error');
          el.classList.remove('field-ok');
        });
        // Show banner with list of missing fields
        var names = invalid.map(function (el) { return fieldLabel(el); }).filter(Boolean);
        validationBanner.innerHTML = '⚠️ કૃપા કરીને આ ફિલ્ડ ભરો: <strong>' + names.join(', ') + '</strong>';
        validationBanner.style.display = '';
        // Scroll to first invalid field
        invalid[0].scrollIntoView({ behavior: 'smooth', block: 'center' });
        invalid[0].focus();
        return;
      }

      // All valid — hide banner and submit
      validationBanner.style.display = 'none';
      btn.classList.add('loading');
      btn.disabled = true;
    });
  })();
</script>

