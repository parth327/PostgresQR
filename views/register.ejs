      <div class="form-section stagger" style="--d:5">
        <h3 class="section-title"><span class="section-num">5</span> <span data-i18n="sec-5-title">તમારો પ્રશ્ન</span></h3>
        <div class="form-grid">
          <div class="field full">
            <label for="f-rss-question" data-i18n="lbl-rss-question">💬 તમારા મનમાં સંઘ કે સંઘના કાર્ય વિશે જિજ્ઞાસા હોય તો આપ અહીંયા લખી શકો છો તમારા પ્રશ્નનો પ્રત્યુતર યુવાસંગમમાં અધિકારી દ્વારા મળશે.</label>
            <textarea id="f-rss-question" name="notes" rows="3" placeholder="તમારો પ્રશ્ન અહીં લખો... (વૈકલ્પિક)" data-i18n-placeholder="ph-rss-question"><%= formData.notes || '' %></textarea>
          </div>
        </div>
      </div>

      <!-- Kept for future use / admin export compatibility, not shown on the public form -->
      <div class="field" style="display:none;">
        <input type="date" name="dob" value="<%= formData.dob || '' %>" />
      </div>
      <div class="field" style="display:none;">
        <select name="gender">
          <option value="">Select</option>
          <option value="Male" <%= formData.gender === 'Male' ? 'selected' : '' %>>Male</option>
          <option value="Female" <%= formData.gender === 'Female' ? 'selected' : '' %>>Female</option>
          <option value="Other" <%= formData.gender === 'Other' ? 'selected' : '' %>>Other</option>
        </select>
      </div>
      <div class="field" style="display:none;">
        <input type="text" name="address" value="<%= formData.address || '' %>" />
      </div>
      <div class="field" style="display:none;">
        <input type="text" name="occupation" value="<%= formData.occupation || '' %>" />
      </div>
      <div class="field" style="display:none;">
        <input type="file" name="photo" accept="image/*" />
      </div>

      <div class="actions-row">
        <button type="submit" class="btn btn-block btn-glow" id="submitBtn">
          <span class="btn-text" data-i18n="btn-submit">ક્લિક કરો અને તમારો ક્યુઆર કોડ જનરેટ કરો</span>
          <span class="btn-spinner" aria-hidden="true"></span>
        </button>
      </div>
      <p class="form-privacy-note" data-i18n="privacy-note">🔒 તમારી માહિતી ફક્ત એડમિન જ QR કોડ સ્કેન કરીને જોઈ શકશે.</p>
    </form>
  </div>
</div>

