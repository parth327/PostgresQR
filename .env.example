PORT=you-port
DATABASE_URL=your-postgres-url
DB_SSL=true/false
APP_BASE_URL=http://localhost:url
SESSION_SECRET=change-this-to-a-long-random-secret-string
ADMIN_USERNAME=adminuser
ADMIN_PASSWORD_HASH=admin-password-hash
# ---- Email (SMTP) — sends the QR code by email after registration ----
# Leave blank to disable email sending (it will be skipped with a warning).
# Example for Gmail: host=smtp.gmail.com, port=587, use an "app password" for SMTP_PASS.
SMTP_HOST=mail-host
SMTP_PORT=465/567
SMTP_SECURE=true/false
SMTP_USER=user-mail-address
SMTP_PASS=user-app-password
EMAIL_FROM=user-email-from


